--==================================================
-- TARGET DEATH
--==================================================

local function MonitorTarget(model)

	local humanoid =
		model and model:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	humanoid.Died:Connect(function()

		if Target ~= model then
			return
		end

		-- El objetivo murió.
		-- Solo lo quitamos.

		ClearTarget()

		-- Gun Aimbot sigue funcionando.
		if GUN_AIM_ENABLED then

			task.delay(0.05,function()

				if GUN_AIM_ENABLED then
					AcquireNearestTarget()
				end

			end)

		elseif TARGET_LOCKED then

			-- TARGET permanece activado,
			-- pero buscamos un nuevo objetivo.

			task.delay(0.05,function()

				if TARGET_LOCKED then
					AcquireNearestTarget()
				end

			end)

		end
	end)
end

--==================================================
-- PROTEGER PERSISTENCIA DE MODOS
--==================================================

local function HandleOwnDeath()

	-- IMPORTANTE:
	-- NO apagamos AIM_ENABLED
	-- NO apagamos GUN_AIM_ENABLED
	-- NO apagamos TARGET_LOCKED

	ClearTarget()

end

--==================================================
-- SETUP CHARACTER
--==================================================

local function SetupCharacter(character)

	Character = character

	CharacterHumanoid =
		character:WaitForChild("Humanoid")

	CharacterHumanoid.Died:Connect(function()

		HandleOwnDeath()

	end)

end

-- Character actual
if LocalPlayer.Character then

	SetupCharacter(
		LocalPlayer.Character
	)

end

--==================================================
-- RESPawn
--==================================================

LocalPlayer.CharacterAdded:Connect(function(character)

	SetupCharacter(character)

	-- NO apagamos ninguna función.
	-- Solo dejamos que el personaje termine
	-- de aparecer antes de buscar objetivo.

	task.delay(0.25,function()

		if AIM_ENABLED
			or GUN_AIM_ENABLED
			or TARGET_LOCKED then

			AcquireNearestTarget()

		end

	end)

end)

--==================================================
-- MAIN AIM LOOP
--==================================================

RunService:BindToRenderStep(
	"MobileHeadAim",
	Enum.RenderPriority.Camera.Value + 1,

	function()

		--------------------------------------------------
		-- GUN AIMBOT
		--------------------------------------------------

		if GUN_AIM_ENABLED then

			if not Target then

				AcquireNearestTarget()

			else

				local humanoid, head =
					GetTargetInfo(Target)

				if not humanoid or not head then

					ClearTarget()

					AcquireNearestTarget()

				elseif not HasLineOfSight(
					Target,
					head
				) then

					ClearTarget()

					AcquireNearestTarget()

				end
			end
		end

		--------------------------------------------------
		-- TARGET MODE
		--------------------------------------------------

		if TARGET_LOCKED and not Target then

			AcquireNearestTarget()

		end

		--------------------------------------------------
		-- AIM
		--------------------------------------------------

		local shouldAim =
			AIM_ENABLED
			and Target ~= nil
			and (
				TARGET_LOCKED
				or GUN_AIM_ENABLED
			)

		if not shouldAim then
			return
		end

		local humanoid, head =
			GetTargetInfo(Target)

		if not humanoid or not head then

			ClearTarget()

			if TARGET_LOCKED
				or GUN_AIM_ENABLED then

				AcquireNearestTarget()

			end

			return
		end

		--------------------------------------------------
		-- VISIBILITY
		--------------------------------------------------

		if not HasLineOfSight(Target, head) then

			if GUN_AIM_ENABLED
				or TARGET_LOCKED then

				ClearTarget()
				AcquireNearestTarget()

			end

			return
		end

		local Camera =
			workspace.CurrentCamera

		if not Camera then
			return
		end

		--------------------------------------------------
		-- AIM HEAD
		--------------------------------------------------

		local cameraPosition =
			Camera.CFrame.Position

		local desiredCFrame =
			CFrame.lookAt(
				cameraPosition,
				head.Position
			)

		Camera.CFrame =
			Camera.CFrame:Lerp(
				desiredCFrame,
				AIM_STRENGTH
			)

	end
)

--==================================================
-- MONITOR TARGET HUMANOID CHANGES
--==================================================

task.spawn(function()

	while true do

		task.wait(0.25)

		if Target then

			local humanoid =
				Target:FindFirstChildOfClass("Humanoid")

			if humanoid
				and humanoid ~= TargetHumanoid then

				TargetHumanoid = humanoid
				MonitorTarget(Target)

			end
		end
	end
end)

