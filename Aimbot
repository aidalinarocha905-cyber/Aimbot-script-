--==================================================
-- DRAG GUI
--==================================================

local dragging = false
local dragStart
local startPosition

Title.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

		dragging = true
		dragStart = input.Position
		startPosition = Frame.Position

	end
end)

Title.InputEnded:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

		dragging = false

	end
end)

UserInputService.InputChanged:Connect(function(input)

	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement then

		local delta = input.Position - dragStart

		Frame.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,

			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)

	end
end)

--==================================================
-- TARGET INFO
--==================================================

local function GetTargetInfo(model)

	if not model or not model:IsA("Model") then
		return nil
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local head = model:FindFirstChild("Head")

	if not humanoid or not head then
		return nil
	end

	if humanoid.Health <= 0 then
		return nil
	end

	return humanoid, head
end

--==================================================
-- PLAYER CHARACTER CHECK
--==================================================

local function IsPlayerCharacter(model)

	return Players:GetPlayerFromCharacter(model) ~= nil

end

--==================================================
-- LINE OF SIGHT
--==================================================

local function HasLineOfSight(targetModel, head)

	local Camera = workspace.CurrentCamera

	if not Camera or not head then
		return false
	end

	local origin = Camera.CFrame.Position
	local direction = head.Position - origin

	if direction.Magnitude <= 0 then
		return false
	end

	local params = RaycastParams.new()

	params.FilterType = Enum.RaycastFilterType.Exclude

	local filter = {}

	if Character then
		table.insert(filter, Character)
	end

	params.FilterDescendantsInstances = filter
	params.IgnoreWater = true

	local result = workspace:Raycast(
		origin,
		direction,
		params
	)

	if not result then
		return true
	end

	if result.Instance:IsDescendantOf(targetModel) then
		return true
	end

	return false
end

--==================================================
-- GET CANDIDATES
--==================================================

local function GetCandidates()

	local candidates = {}

	-- Players
	for _, player in ipairs(Players:GetPlayers()) do

		if player ~= LocalPlayer then

			local character = player.Character

			if character then

				local humanoid, head =
					GetTargetInfo(character)

				if humanoid and head then
					table.insert(candidates, character)
				end

			end
		end
	end

	-- NPCs
	for _, object in ipairs(workspace:GetDescendants()) do

		if object:IsA("Model")
			and not IsPlayerCharacter(object) then

			local humanoid, head =
				GetTargetInfo(object)

			if humanoid and head then
				table.insert(candidates, object)
			end

		end
	end

	return candidates
end

--==================================================
-- FIND BEST TARGET
--==================================================

local function FindBestTarget()

	local Camera = workspace.CurrentCamera

	if not Camera then
		return nil
	end

	local cameraPosition = Camera.CFrame.Position
	local lookVector = Camera.CFrame.LookVector

	local candidates = GetCandidates()

	local bestTarget = nil
	local bestScore = math.huge

	for _, model in ipairs(candidates) do

		local humanoid, head =
			GetTargetInfo(model)

		if humanoid and head then

			local offset =
				head.Position - cameraPosition

			local distance =
				offset.Magnitude

			if distance <= MAX_TARGET_DISTANCE then

				-- Wall check
				if HasLineOfSight(model, head) then

					local direction =
						offset.Unit

					local alignment =
						math.max(
							-1,
							math.min(
								1,
								lookVector:Dot(direction)
							)
						)

					local score =
						distance
						-
						(
							alignment
							* LOOK_WEIGHT
							* distance
						)

					if score < bestScore then

						bestScore = score
						bestTarget = model

					end
				end
			end
		end
	end

	return bestTarget
end

--==================================================
-- SET TARGET
--==================================================

local function SetTarget(model)

	if not model then
		return false
	end

	local humanoid, head =
		GetTargetInfo(model)

	if not humanoid or not head then
		return false
	end

	if not HasLineOfSight(model, head) then
		return false
	end

	Target = model
	TargetHumanoid = humanoid

	return true
end

--==================================================
-- CLEAR TARGET
--==================================================

local function ClearTarget()

	Target = nil
	TargetHumanoid = nil

end

--==================================================
-- UPDATE TARGET BUTTON
--==================================================

local function UpdateTargetButton()

	if TARGET_LOCKED then

		TargetButton.Text = "LOCK"
		TargetButton.BackgroundColor3 =
			Color3.fromRGB(190,60,60)

	else

		TargetButton.Text = "TARGET"
		TargetButton.BackgroundColor3 =
			Color3.fromRGB(55,55,55)

	end
end

--==================================================
-- ACQUIRE TARGET
--==================================================

local function AcquireNearestTarget()

	local newTarget =
		FindBestTarget()

	if newTarget then

		if SetTarget(newTarget) then
			return true
		end
	end

	ClearTarget()

	return false
end

--==================================================
-- TARGET BUTTON
--==================================================

TargetButton.Activated:Connect(function()

	if TARGET_LOCKED then

		TARGET_LOCKED = false
		ClearTarget()
		UpdateTargetButton()

		return
	end

	if AcquireNearestTarget() then

		TARGET_LOCKED = true
		UpdateTargetButton()

	else

		TargetButton.Text = "NO TARGET"

		task.delay(0.7,function()

			if not TARGET_LOCKED then
				UpdateTargetButton()
			end

		end)
	end
end)

