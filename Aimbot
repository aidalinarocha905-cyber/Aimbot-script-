--========================================================
-- GET AIM PART
--========================================================

local function GetAimPart(model)

	if not model then
		return nil
	end

	if AIM_PART == "Head" then
		return model:FindFirstChild("Head")
	end

	if AIM_PART == "Torso" then
		return model:FindFirstChild("UpperTorso")
			or model:FindFirstChild("Torso")
	end

	if AIM_PART == "Root" then
		return model:FindFirstChild("HumanoidRootPart")
	end

	return model:FindFirstChild("Head")
end

--========================================================
-- VALID TARGET
--========================================================

local function GetTargetData(model)

	if not model or not model:IsA("Model") then
		return nil
	end

	if model == Character then
		return nil
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local part = GetAimPart(model)

	if not humanoid or not part then
		return nil
	end

	if humanoid.Health <= 0 then
		return nil
	end

	return humanoid, part
end

--========================================================
-- LINE OF SIGHT
--========================================================

local function CanSeeTarget(model, part)

	local camera = workspace.CurrentCamera

	if not camera or not part then
		return false
	end

	local origin = camera.CFrame.Position
	local direction = part.Position - origin

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true

	local filter = {}

	if Character then
		table.insert(filter, Character)
	end

	params.FilterDescendantsInstances = filter

	local result = workspace:Raycast(
		origin,
		direction,
		params
	)

	if not result then
		return true
	end

	return result.Instance:IsDescendantOf(model)
end

--========================================================
-- IS PLAYER CHARACTER
--========================================================

local function IsPlayerCharacter(model)

	return Players:GetPlayerFromCharacter(model) ~= nil

end

--========================================================
-- GET CANDIDATES
--========================================================

local function GetCandidates()

	local candidates = {}

	-- PLAYERS
	for _, player in ipairs(Players:GetPlayers()) do

		if player ~= LocalPlayer then

			local character = player.Character

			if character then
				local humanoid, part =
					GetTargetData(character)

				if humanoid and part then
					table.insert(candidates, character)
				end
			end
		end
	end

	-- NPCS
	for _, object in ipairs(workspace:GetDescendants()) do

		if object:IsA("Model")
			and not IsPlayerCharacter(object) then

			local humanoid, part =
				GetTargetData(object)

			if humanoid and part then
				table.insert(candidates, object)
			end
		end
	end

	return candidates
end

--========================================================
-- FIND BEST TARGET
--========================================================

local function FindBestTarget()

	local camera = workspace.CurrentCamera

	if not camera then
		return nil
	end

	local cameraPosition = camera.CFrame.Position
	local lookVector = camera.CFrame.LookVector

	local bestTarget = nil
	local bestScore = math.huge

	for _, model in ipairs(GetCandidates()) do

		local humanoid, part =
			GetTargetData(model)

		if humanoid and part then

			local offset =
				part.Position - cameraPosition

			local distance =
				offset.Magnitude

			if distance <= MAX_DISTANCE then

				-- Nunca selecciona objetivos
				-- que no puedas ver.

				if CanSeeTarget(model, part) then

					local direction = offset.Unit

					local alignment =
						lookVector:Dot(direction)

					-- Prioriza cercanía y objetivos
					-- hacia donde estás mirando.

					local score =
						distance
						- (alignment * 100)

					if score < bestScore then

						bestScore = score
						bestTarget = model

					end
				end
			end
		end
	end

	return bestTarget
end

--========================================================
-- CLEAR TARGET
--========================================================

local function ClearTarget()

	CurrentTarget = nil

end

--========================================================
-- ACQUIRE
--========================================================

local function AcquireTarget()

	local target = FindBestTarget()

	if target then
		CurrentTarget = target
		return true
	end

	ClearTarget()
	return false
end

