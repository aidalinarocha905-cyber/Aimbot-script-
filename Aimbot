--========================================================
-- DRAG FLOATING BUTTON
--========================================================

local dragging = false
local dragStart
local startPosition

OpenButton.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

		dragging = true
		dragStart = input.Position
		startPosition = OpenButton.Position

	end
end)

OpenButton.InputEnded:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

		dragging = false

	end
end)

UserInputService.InputChanged:Connect(function(input)

	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement then

		local delta =
			input.Position - dragStart

		OpenButton.Position =
			UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,

				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)

	end
end)

--========================================================
-- TARGET DEATH MONITOR
--========================================================

local function WatchTarget(model)

	local humanoid =
		model and model:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	humanoid.Died:Connect(function()

		if CurrentTarget ~= model then
			return
		end

		ClearTarget()

		-- No apagamos las funciones.
		-- Solo buscamos otro objetivo.

		if TARGET_MODE or GUN_AIM_ENABLED then

			task.delay(0.1, function()

				if TARGET_MODE or GUN_AIM_ENABLED then
					AcquireTarget()
				end

			end)
		end
	end)
end

--========================================================
-- OWN CHARACTER
--========================================================

local function SetupCharacter(character)

	Character = character

	Humanoid =
		character:WaitForChild("Humanoid")

	Humanoid.Died:Connect(function()

		-- IMPORTANTE:
		-- NO desactiva AIM
		-- NO desactiva TARGET
		-- NO desactiva GUN AIMBOT

		ClearTarget()

	end)
end

if LocalPlayer.Character then
	SetupCharacter(LocalPlayer.Character)
end

--========================================================
-- RESPAWN
--========================================================

LocalPlayer.CharacterAdded:Connect(function(character)

	SetupCharacter(character)

	task.delay(0.35, function()

		if AIM_ENABLED
			or TARGET_MODE
			or GUN_AIM_ENABLED then

			AcquireTarget()

		end
	end)
end)

--========================================================
-- MAIN LOOP
--========================================================

RunService:BindToRenderStep(
	"MobileAimSystem",
	Enum.RenderPriority.Camera.Value + 1,
	function()

		--============================================
		-- GUN AIMBOT / AUTO REACQUIRE
		--============================================

		if GUN_AIM_ENABLED then

			if not CurrentTarget then

				AcquireTarget()

			else

				local humanoid, part =
					GetTargetData(CurrentTarget)

				if not humanoid or not part then

					ClearTarget()
					AcquireTarget()

				elseif not CanSeeTarget(
					CurrentTarget,
					part
				) then

					ClearTarget()
					AcquireTarget()

				end
			end
		end

		--============================================
		-- TARGET MODE
		--============================================

		if TARGET_MODE and not CurrentTarget then
			AcquireTarget()
		end

		--============================================
		-- AIM
		--============================================

		if not AIM_ENABLED then
			return
		end

		if not CurrentTarget then
			return
		end

		local humanoid, part =
			GetTargetData(CurrentTarget)

		if not humanoid or not part then

			ClearTarget()

			if TARGET_MODE or GUN_AIM_ENABLED then
				AcquireTarget()
			end

			return
		end

		--============================================
		-- WALL CHECK
		--============================================

		if not CanSeeTarget(
			CurrentTarget,
			part
		) then

			ClearTarget()

			if TARGET_MODE or GUN_AIM_ENABLED then
				AcquireTarget()
			end

			return
		end

		--============================================
		-- CAMERA AIM
		--============================================

		local camera =
			workspace.CurrentCamera

		if not camera then
			return
		end

		local cameraPosition =
			camera.CFrame.Position

		local desired =
			CFrame.lookAt(
				cameraPosition,
				part.Position
			)

		camera.CFrame =
			camera.CFrame:Lerp(
				desired,
				AIM_SMOOTHNESS
			)

	end
)

