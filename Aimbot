--==================================================
-- DESACTIVAR TODO AL MORIR
--==================================================

local function DisableOnDeath()

	AIM_ENABLED = false
	TARGET_LOCKED = false
	GUN_AIM_ENABLED = false

	ClearTarget()

	AimButton.Text = "AIM"
	AimButton.BackgroundColor3 =
		Color3.fromRGB(55,55,55)

	GunButton.Text = "GUN AIMBOT"
	GunButton.BackgroundColor3 =
		Color3.fromRGB(55,55,55)

	UpdateTargetButton()

end

--==================================================
-- CONFIGURAR NUESTRO PERSONAJE
--==================================================

local function SetupCharacter(character)

	Character = character

	CharacterHumanoid =
		character:WaitForChild("Humanoid")

	CharacterHumanoid.Died:Connect(function()

		DisableOnDeath()

	end)
end

-- Personaje actual
if LocalPlayer.Character then
	SetupCharacter(LocalPlayer.Character)
end

-- Respawn
LocalPlayer.CharacterAdded:Connect(function(character)

	SetupCharacter(character)

	-- El aimbot queda apagado después de respawnear.
	DisableOnDeath()

end)

--==================================================
-- AIM LOOP
--==================================================

RunService:BindToRenderStep(
	"MobileHeadAim",
	Enum.RenderPriority.Camera.Value + 1,

	function()

		--------------------------------------------------
		-- GUN AIMBOT
		--------------------------------------------------

		if GUN_AIM_ENABLED then

			if not Target then

				AcquireNearestTarget()

			else

				local humanoid, head =
					GetTargetInfo(Target)

				--------------------------------------------------
				-- OBJETIVO MUERTO
				--------------------------------------------------

				if not humanoid or not head then

					ClearTarget()

					AcquireNearestTarget()

				--------------------------------------------------
				-- OBJETIVO YA NO ES VISIBLE
				--------------------------------------------------

				elseif not HasLineOfSight(
					Target,
					head
				) then

					-- Buscar otro objetivo visible
					ClearTarget()

					AcquireNearestTarget()

				end
			end
		end

		--------------------------------------------------
		-- AIM NORMAL
		--------------------------------------------------

		local shouldAim =
			AIM_ENABLED
			and Target ~= nil
			and (
				TARGET_LOCKED
				or GUN_AIM_ENABLED
			)

		if not shouldAim then
			return
		end

		local humanoid, head =
			GetTargetInfo(Target)

		if not humanoid or not head then

			ClearTarget()

			if GUN_AIM_ENABLED then

				AcquireNearestTarget()

			else

				TARGET_LOCKED = false
				UpdateTargetButton()

			end

			return
		end

		--------------------------------------------------
		-- SI EL OBJETIVO QUEDA DETRÁS DE UNA PARED
		--------------------------------------------------

		if not HasLineOfSight(Target, head) then

			if GUN_AIM_ENABLED then

				ClearTarget()
				AcquireNearestTarget()

			end

			return
		end

		local Camera =
			workspace.CurrentCamera

		if not Camera then
			return
		end

		--------------------------------------------------
		-- APUNTAR AL HEAD
		--------------------------------------------------

		local cameraPosition =
			Camera.CFrame.Position

		local desiredCFrame =
			CFrame.lookAt(
				cameraPosition,
				head.Position
			)

		Camera.CFrame =
			Camera.CFrame:Lerp(
				desiredCFrame,
				AIM_STRENGTH
			)

	end
)
