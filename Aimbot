--========================================================
-- FRIEND ID CHECK
--========================================================

local function IsInFriendList(player)

	if not player then
		return false
	end

	return table.find(FriendIDs,player.UserId) ~= nil
end

local function IsFriend(player)

	if not player then
		return false
	end

	if player == LP then
		return true
	end

	-- Lista personalizada
	if IsInFriendList(player) then
		return true
	end

	-- Amigos reales de Roblox
	local ok,result = pcall(function()
		return LP:IsFriendsWith(player.UserId)
	end)

	return ok and result
end

--========================================================
-- TARGET HELPERS
--========================================================

local function GetHumanoid(model)
	return model and model:FindFirstChildOfClass("Humanoid")
end

local function GetPart(model)

	if not model then
		return nil
	end

	if CFG.AimPart == "Head" then

		return model:FindFirstChild("Head")

	elseif CFG.AimPart == "Torso" then

		return model:FindFirstChild("UpperTorso")
			or model:FindFirstChild("Torso")

	else

		return model:FindFirstChild("HumanoidRootPart")
	end
end

local function Alive(model)

	local h = GetHumanoid(model)

	return h and h.Health > 0
end

local function SameTeam(player)

	if not player then
		return false
	end

	if LP.Team ~= nil and player.Team ~= nil then
		return LP.Team == player.Team
	end

	return false
end

--========================================================
-- WALL CHECK
--========================================================

local function Visible(part)

	if not CFG.WallCheck then
		return true
	end

	if not Character or not Root then
		return false
	end

	local origin = Camera.CFrame.Position
	local direction = part.Position - origin

	local params = RaycastParams.new()

	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {
		Character
	}

	local hit = workspace:Raycast(
		origin,
		direction,
		params
	)

	if not hit then
		return true
	end

	return hit.Instance:IsDescendantOf(part.Parent)
end

--========================================================
-- VALID PLAYER
--========================================================

local function ValidPlayer(player)

	if player == LP then
		return false
	end

	if not CFG.Players then
		return false
	end

	local char = player.Character

	if not char or not Alive(char) then
		return false
	end

	-- ID personalizado + amigos Roblox
	if CFG.Friends and IsFriend(player) then
		return false
	end

	if CFG.EnemyOnly and SameTeam(player) then
		return false
	end

	local part = GetPart(char)

	if not part then
		return false
	end

	return true,part,char
end

--========================================================
-- NPC
--========================================================

local function IsNPC(model)

	if not model:IsA("Model") then
		return false
	end

	if model == Character then
		return false
	end

	local h = GetHumanoid(model)

	if not h or h.Health <= 0 then
		return false
	end

	if Players:GetPlayerFromCharacter(model) then
		return false
	end

	return true
end

--========================================================
-- FIND TARGET
--========================================================

local function FindTarget()

	if not Camera then
		return nil
	end

	local best
	local bestDistance = math.huge

	-- PLAYERS
	if CFG.Players then

		for _,player in ipairs(Players:GetPlayers()) do

			local valid,part,char = ValidPlayer(player)

			if valid then

				local distance =
					(part.Position - Camera.CFrame.Position).Magnitude

				if distance <= CFG.MaxDistance
				and distance < bestDistance
				and Visible(part) then

					local _,onScreen =
						Camera:WorldToViewportPoint(part.Position)

					if onScreen then

						best = {
							Model = char,
							Player = player,
							Part = part
						}

						bestDistance = distance
					end
				end
			end
		end
	end

	-- NPCs
	if CFG.NPCs then

		for _,model in ipairs(workspace:GetDescendants()) do

			if IsNPC(model) then

				local part = GetPart(model)

				if part then

					local distance =
						(part.Position - Camera.CFrame.Position).Magnitude

					if distance <= CFG.MaxDistance
					and distance < bestDistance
					and Visible(part) then

						local _,onScreen =
							Camera:WorldToViewportPoint(part.Position)

						if onScreen then

							best = {
								Model = model,
								Player = nil,
								Part = part
							}

							bestDistance = distance
						end
					end
				end
			end
		end
	end

	return best
end

--========================================================
-- CURRENT TARGET
--========================================================

local CurrentTarget

local function TargetStillValid(t)

	if not t then
		return false
	end

	if not t.Model
	or not t.Model.Parent
	or not Alive(t.Model) then

		return false
	end

	-- Si es jugador, volver a comprobar amigos/equipo
	if t.Player then

		if CFG.Friends and IsFriend(t.Player) then
			return false
		end

		if CFG.EnemyOnly and SameTeam(t.Player) then
			return false
		end
	end

	local part = GetPart(t.Model)

	if not part then
		return false
	end

	if CFG.WallCheck and not Visible(part) then
		return false
	end

	t.Part = part

	return true
end

--========================================================
-- ESP
--========================================================

local ESPObjects = {}

local function RemoveESP(model)

	local h = ESPObjects[model]

	if h then
		h:Destroy()
		ESPObjects[model] = nil
	end
end

local function MakeESP(model,player)

	if ESPObjects[model] then
		return
	end

	local h = Instance.new("Highlight")

	h.Name = "AimESP"
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.FillTransparency = .65
	h.OutlineTransparency = 0

	if player then

		if SameTeam(player) then

			h.FillColor =
				Color3.fromRGB(50,100,255)

			h.OutlineColor =
				Color3.fromRGB(100,160,255)

		else

			h.FillColor =
				Color3.fromRGB(255,50,50)

			h.OutlineColor =
				Color3.fromRGB(255,120,120)
		end

	else

		h.FillColor =
			Color3.fromRGB(255,170,40)

		h.OutlineColor =
			Color3.fromRGB(255,220,100)
	end

	h.Adornee = model
	h.Parent = model

	ESPObjects[model] = h
end

local function UpdateESP()

	if not CFG.ESP then

		for model in pairs(ESPObjects) do
			RemoveESP(model)
		end

		return
	end

	local seen = {}

	if CFG.Players then

		for _,p in ipairs(Players:GetPlayers()) do

			if p ~= LP
			and p.Character
			and Alive(p.Character) then

				seen[p.Character] = true

				if not (CFG.Friends and IsFriend(p)) then
					MakeESP(p.Character,p)
				else
					RemoveESP(p.Character)
				end
			end
		end
	end

	if CFG.NPCs then

		for _,m in ipairs(workspace:GetDescendants()) do

			if IsNPC(m) then

				seen[m] = true
				MakeESP(m,nil)
			end
		end
	end

	for model in pairs(ESPObjects) do

		if not seen[model] then
			RemoveESP(model)
		end
	end
end

--========================================================
-- AIM LOOP
--========================================================

local ESPTimer = 0

RunService.RenderStepped:Connect(function(dt)

	if not Character
	or not Humanoid
	or Humanoid.Health <= 0 then

		CurrentTarget = nil
		return
	end

	-- Buscar/reemplazar objetivo
	if CFG.Target or CFG.Aim or CFG.Gun then

		if not TargetStillValid(CurrentTarget) then
			CurrentTarget = FindTarget()
		end

	else

		CurrentTarget = nil
	end

	-- AIM / GUN AIMBOT
	if CFG.Aim or CFG.Gun then

		if CurrentTarget
		and TargetStillValid(CurrentTarget) then

			Camera.CFrame =
				CFrame.lookAt(
					Camera.CFrame.Position,
					CurrentTarget.Part.Position
				)
		end
	end

	-- ESP
	ESPTimer += dt

	if ESPTimer >= .25 then

		ESPTimer = 0
		UpdateESP()
	end
end)

